<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- 專案無關的 MCP 治理層：驗證、scope、個資遮罩、兩段式確認、稽核。不可引用任何業務專案。 -->
    <Description>Project-agnostic governance layer for MCP servers (auth, scopes, PII masking, confirmation, audit).</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
  </ItemGroup>

</Project>
